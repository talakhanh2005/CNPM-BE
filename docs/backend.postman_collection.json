{
  "info": {
    "name": "Backend 1.2 regression",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Run with six pre-provisioned users; each run creates a fresh room. WebSocket and ingest regression are covered by pytest."
  },
  "item": [
    {
      "name": "Health",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/health"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "const body = pm.response.json();",
              "pm.test('Envelope', () => { pm.expect(body).to.have.keys('success','data','message'); });",
              "pm.test('Success flag', () => pm.expect(body.success).to.eql(true));"
            ]
          }
        }
      ]
    },
    {
      "name": "Login teacher",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/auth/login",
        "body": {
          "mode": "raw",
          "raw": "{\"email\": \"{{teacher_email}}\", \"password\": \"{{teacher_password}}\"}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "const body = pm.response.json();",
              "pm.test('Envelope', () => { pm.expect(body).to.have.keys('success','data','message'); });",
              "pm.test('Success flag', () => pm.expect(body.success).to.eql(true));",
              "if (body.success) { pm.environment.set('teacher_token', body.data.access_token); }",
              "pm.test('JWT fields', () => { pm.expect(body.data.access_token).to.be.a('string'); pm.expect(body.data.refresh_token).to.be.a('string'); });"
            ]
          }
        }
      ]
    },
