ENVIRONMENT=development
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters
# Same server/instance as in SQL Server Management Studio; keep single quotes.
SQLSERVER_SERVER='localhost\SQLEXPRESS'
SQLSERVER_DATABASE=face_emotion
SQLSERVER_DRIVER=ODBC Driver 18 for SQL Server
# Windows Authentication:
SQLSERVER_TRUSTED_CONNECTION=true
SQLSERVER_USERNAME=
SQLSERVER_PASSWORD=
SQLSERVER_ENCRYPT=true
# Local development with self-signed certificate only; false in production.
SQLSERVER_TRUST_SERVER_CERTIFICATE=true
BCRYPT_ROUNDS=12
ALLOW_TEACHER_REGISTRATION=false
TEACHER_REGISTRATION_KEY=
CORS_ORIGINS=["http://localhost:3000","http://localhost:8000"]
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
MAX_UPLOAD_BYTES=67108864
MAX_RECORDING_SECONDS=7200
UPLOAD_SLOTS=2
UPLOAD_TIMEOUT_SECONDS=120
AI_MODE=mock
AI_BASE_URL=http://localhost:9000
AI_API_KEY=
AI_TIMEOUT_SECONDS=120
FRAME_TIMEOUT_SECONDS=10
JOB_LEASE_SECONDS=300
WORKER_POLL_SECONDS=2
FRAME_INTERVAL_SECONDS=1
MAX_FRAME_BYTES=524288
