ENVIRONMENT=development
# MongoDB là database duy nhất. Tên database lấy từ path của URI (Atlas: mongodb+srv://...).
MONGO_URI=mongodb://localhost:27017/face_emotion
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters
BCRYPT_ROUNDS=12
ALLOW_TEACHER_REGISTRATION=false
TEACHER_REGISTRATION_KEY=
# Emails that always register as teacher, comma separated (merged from BE A).
TEACHER_EMAIL_WHITELIST=
# Seed one admin account at startup; set both or neither.
ADMIN_EMAIL=
ADMIN_PASSWORD=
# 5173 = Vite dev server (FE); the WebSocket origin check uses this list.
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://localhost:8000"]
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Generic media (recording-file, signed upload, v1 emotions).
CLOUDINARY_FOLDER=emotion-media
CLOUDINARY_MAX_UPLOAD_BYTES=10485760
CLOUDINARY_UPLOAD_TIMEOUT=30
MAX_UPLOAD_BYTES=67108864
MAX_RECORDING_SECONDS=7200
UPLOAD_SLOTS=2
UPLOAD_TIMEOUT_SECONDS=120
# Dịch vụ AI thật (CNPM-NC). AI_API_KEY phải trùng AI_API_KEY của dịch vụ AI.
AI_BASE_URL=http://localhost:9000
AI_API_KEY=
AI_TIMEOUT_SECONDS=120
FRAME_TIMEOUT_SECONDS=10
# Chatbot (POST /meetings/{id}/chat): Gemini only parses questions the rules do not understand.
# Leave empty to run the chatbot with rules only. Never commit a real key.
GEMINI_API_KEY=
CHAT_LLM_MODEL=gemini-3.5-flash
CHAT_LLM_TIMEOUT_SECONDS=20
JOB_LEASE_SECONDS=300
WORKER_POLL_SECONDS=2
FRAME_INTERVAL_SECONDS=0.3333333333333333
MAX_FRAME_BYTES=524288
EMOTION_LOG_INTERVAL_SECONDS=90
WS_MAX_MESSAGE_BYTES=1048576
# One teacher plus students (2-100). Mesh WebRTC: keep it small.
MAX_ROOM_CONNECTIONS=30
# Window (seconds) of the EMOTION_AGGREGATE event sent to the teacher during realtime.
EMOTION_AGGREGATION_WINDOW_SECONDS=30
# Secret for the optional AI callback POST /internal/emotions (header X-AI-Key).
# Independent of AI_API_KEY; leave empty to disable the callback.
INTERNAL_AI_KEY=
MAX_DOCUMENT_BYTES=20971520
MAX_DOCUMENTS_PER_MEETING=100
# FE must pass these to RTCPeerConnection; replace TURN values with infrastructure credentials.
# When ICE_SERVERS is empty, STUN_URLS/TURN_* are used instead.
ICE_SERVERS=[]
STUN_URLS=["stun:stun.l.google.com:19302"]
TURN_URLS=[]
TURN_USERNAME=
TURN_CREDENTIAL=
# ICE_SERVERS=[{"urls":["stun:your-host:3478"]},{"urls":["turn:your-host:3478","turns:your-host:5349"],"username":"your-user","credential":"your-password"}]
