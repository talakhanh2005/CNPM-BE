MONGO_DB_NAME=cnpm_be
JWT_SECRET_KEY=replace-with-a-random-secret-at-least-32-characters-long
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Optional. Emotion records work without Cloudinary; media uploads require all three values.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=emotion-media
CLOUDINARY_MAX_UPLOAD_BYTES=10485760
CLOUDINARY_ALLOWED_FORMATS=["jpg","jpeg","png","webp","mp4","mov"]

# Optional. Configure both values to bootstrap an admin account at startup.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Optional. ICE servers handed to the classroom frontend for WebRTC.
STUN_URLS=["stun:stun.l.google.com:19302"]
TURN_URLS=[]
TURN_USERNAME=
TURN_CREDENTIAL=
